# Environment
.env

# Runtime database and generated artifacts (data/source/ IS tracked; this is
# not). Wildcarded rather than named after one default filename, since
# DATABASE_PATH/PSEUDONYM_VAULT_PATH are configurable.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/artifacts/
data/cache/
data/privacy_ops/

# Architecture v1.6 isolated reversal vault (CLAUDE.md 18.0.3): the most
# sensitive directory in the app -- it must never be committed, regardless
# of PSEUDONYM_VAULT_PATH's configured filename.
data/private-vault/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / frontend build output
node_modules/
frontend/dist/
frontend/.vite/

# OS / editor junk
.DS_Store
Thumbs.db

# Personal/session-local Claude Code permission state (machine-specific)
.claude/settings.local.json

# Zip-extraction leftovers from the original challenge archive download.
# The canonical, application-owned copy of this data lives in data/source/.
/corpus/
/__MACOSX/

# Challenge reference materials, not part of the application
/*.pptx
/parse_pptx.ps1
.vercel
