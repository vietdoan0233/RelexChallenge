# Safe placeholders only. Copy this file to .env and put secrets there.
# Verified organizer contract: OpenAI-compatible HTTPS /v1/embeddings and
# /v1/chat/completions (GPT_MODEL; JSON mode works, default temperature only).
GPT_API_KEY=
GPT_BASE_URL=
GPT_MODEL=
GPT_EMBEDDING_MODEL=
DATABASE_PATH=./data/app.db
SOURCE_DATA_DIR=./data/source

# "KEEPER" is a temporary codename, not a frozen brand. Leave these empty to
# use the neutral fallback ("Organizational Memory Auditor"), or set both to
# the same value to rename the running app without touching code. Frontend
# env vars need the VITE_ prefix to be exposed to client-side code.
APP_NAME=
VITE_APP_NAME=

# Architecture v1.6 pseudonymisation (CLAUDE.md 18.0). The vault is a
# separate encrypted file, never a table in DATABASE_PATH. Generate a real
# key for your local .env with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving PSEUDONYM_VAULT_KEY empty makes every pseudonymisation/reversal
# call fail closed (fails, never falls back to storing plaintext).
PSEUDONYM_VAULT_PATH=./data/private-vault/vault.db.enc
PSEUDONYM_VAULT_KEY=demo-admin-token

# Bearer token required by POST /api/privacy/pseudonymise and the admin
# reversal endpoint. This is the shared team demo token (it is also in the
# README), so every instance created from this template accepts it. It is
# public: use your own value before exposing an instance to anyone you do not
# trust. Leaving it empty makes both endpoints fail closed (401) rather than
# treating a missing token as "no auth required".
PRIVACY_ADMIN_TOKEN=demo-admin-token
